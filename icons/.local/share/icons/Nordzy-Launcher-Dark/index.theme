# The launcher's (fuzzel) icons: Nordzy's Nord-coloured app icons, aliases (made by install.sh) for
# apps Nordzy lacks, then Papirus for anything else.
[Icon Theme]
Name=Nordzy-Launcher-Dark
Comment=Nordzy for the fuzzel launcher, dark mode
Inherits=Nordzy-dark,Papirus-Dark,hicolor
Directories=apps/scalable

[apps/scalable]
Size=64
Context=Applications
MinSize=16
MaxSize=512
Type=Scalable
