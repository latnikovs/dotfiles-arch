#!/usr/bin/env bash
# Night light on or off by hand (SUPER + CTRL + N); hyprsunset.conf's schedule
# takes over again at its next switch. Starts hyprsunset if it isn't running.
set -euo pipefail

warm=4000

if ! pgrep -x hyprsunset >/dev/null; then
    hyprctl dispatch 'hl.dsp.exec_cmd("hyprsunset")' >/dev/null
    for _ in {1..20}; do
        hyprctl hyprsunset identity get &>/dev/null && break
        sleep 0.1
    done
fi

# `temperature` still reports the last warm value after an identity switch, so ask identity
if [[ $(hyprctl hyprsunset identity get) == true ]] || (($(hyprctl hyprsunset temperature) >= 6500)); then
    hyprctl hyprsunset temperature "$warm" >/dev/null
    notify-send -a "Night light" -i weather-clear-night "Night light on" "${warm}K"
else
    hyprctl hyprsunset identity >/dev/null
    notify-send -a "Night light" -i weather-clear "Night light off"
fi
