#!/usr/bin/env python3
# Usage: herd-numbers   keeps each herdr space's number (what switch_workspace's 1..9 jump to) in a
#                       $num sidebar token; started by herd, exits when the herdr server goes away
# herdr has no built-in token for the number, so it is reported as workspace metadata and
# re-reported whenever spaces are created, closed or reordered.
import json
import os
import socket
import subprocess
import time

SOCK = os.path.expanduser("~/.config/herdr/herdr.sock")
EVENTS = ["workspace.created", "workspace.closed", "workspace.moved", "workspace.reordered"]


def sync():
    out = subprocess.run(["herdr", "workspace", "list"], capture_output=True, text=True, check=True)
    for ws in json.loads(out.stdout)["result"]["workspaces"]:
        # The workspace ID must come before the options, herdr rejects it after them
        subprocess.run(["herdr", "workspace", "report-metadata", ws["workspace_id"],
                        "--source", "herd-numbers", "--token", f"num={ws['number']}"],
                       capture_output=True, check=False)


def connect():
    # herd starts this alongside a herdr that may still be bringing its server up
    for _ in range(30):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(SOCK)
            return s
        except OSError:
            time.sleep(1)
    raise SystemExit("herd-numbers: herdr server not reachable")


s = connect()
s.sendall((json.dumps({"id": "herd-numbers", "method": "events.subscribe",
                       "params": {"subscriptions": [{"type": t} for t in EVENTS]}}) + "\n").encode())
# Each event line triggers a full resync: closing or moving one space renumbers the ones after it
for line in s.makefile():
    sync()
