#!/usr/bin/env bash
# Usage: clipboard-history   pick from the clipboard history (cliphist) and paste it
set -euo pipefail

pkill -x fuzzel && exit 0

entry=$(cliphist list \
    | fuzzel --dmenu --with-nth 2 --prompt "󰅌   " --placeholder Clipboard --width 70 --lines 12) || exit  # Esc: 2, for scripts/menu
cliphist decode <<<"$entry" | wl-copy

# Paste into the window that had focus: SHIFT + Insert pastes in both GUI apps and kitty
# (mapped in kitty.conf), so terminals need no special case.
key() { hyprctl dispatch "hl.dsp.send_key_state({ mods = 'SHIFT', key = 'Insert', state = '$1' })" >/dev/null; }
sleep 0.15
key down
sleep 0.05
key up
