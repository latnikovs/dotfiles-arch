#!/usr/bin/env bash
# Usage: system menu|lock|suspend|logout|reboot|shutdown   power actions, after Omarchy's omarchy-system-*
set -euo pipefail

# Close every window and wait for the apps behind them to exit, so they shut down cleanly instead
# of being killed: Chromium-based browsers keep writing their session and prefs for a while after
# the window is gone, and Brave then reports it "didn't shut down correctly". Gives up after 15s
# (an app asking to save, say) and goes ahead anyway
close_all() {
    local clients pids
    clients=$(hyprctl clients -j)
    mapfile -t pids < <(jq -r '.[].pid | select(. > 0)' <<<"$clients" | sort -u)
    jq -r '.[].address' <<<"$clients" | while read -r addr; do
        hyprctl dispatch "hl.dsp.window.close({ window = 'address:$addr' })" >/dev/null
    done
    # herdr's server outlives its window, with the agents in it; stopped the same way, or systemd
    # SIGKILLs it at shutdown
    if pgrep -x herdr >/dev/null; then
        mapfile -t -O "${#pids[@]}" pids < <(pgrep -x herdr)
        timeout 5 herdr server stop >/dev/null 2>&1 || true
    fi
    (( ${#pids[@]} )) || return 0
    for _ in {1..150}; do
        kill -0 "${pids[@]}" 2>/dev/null || break
        sleep 0.1
    done
}

# Run in the systemd user manager, so closing the window this was run from can't cancel it
detach() {
    systemd-run --user --collect --quiet "$(realpath "$0")" "_$1"
}

case ${1:-menu} in
    menu)
        pkill -x fuzzel && exit 0
        # Opened from the menu (scripts/menu) it ends in Back, and Left goes back too; Back and
        # Esc exit 2, Left 10, which take the menu back to its main list
        # DOTFILES_NO_SUSPEND hides Suspend on machines that can't wake from it (machines/utm-vm.lua)
        items=("󰌾  Lock")
        [[ -n ${DOTFILES_NO_SUSPEND:-} ]] || items+=("󰒲  Suspend")
        items+=("󰍃  Logout" "󰜉  Reboot" "󰐥  Shutdown")
        [[ -z ${DOTFILES_MENU:-} ]] || items+=("󰁍  Back")
        choice=$(printf '%s\n' "${items[@]}" \
            | fuzzel ${DOTFILES_MENU:+--config=$HOME/.config/fuzzel/menu.ini} --dmenu --prompt "󰐥   " --placeholder System --width 18 --lines ${#items[@]}) || exit
        [[ $choice != *"  Back" ]] || exit 2
        exec "$0" "$(awk '{ print tolower($2) }' <<<"$choice")"
        ;;
    lock)     exec ~/.config/hypr/scripts/lock ;;
    suspend)  systemctl suspend ;;
    logout)   detach logout ;;
    reboot)   detach reboot ;;
    shutdown) detach shutdown ;;
    _logout)
        notify-send -a system -u low "Logging out"
        close_all
        hyprctl dispatch 'hl.dsp.exit()' >/dev/null
        ;;
    _reboot)
        notify-send -a system -u low "Rebooting"
        close_all
        systemctl reboot --no-wall
        ;;
    _shutdown)
        notify-send -a system -u low "Shutting down"
        close_all
        systemctl poweroff --no-wall
        ;;
    *)
        echo "Usage: system menu|lock|suspend|logout|reboot|shutdown" >&2
        exit 1
        ;;
esac
