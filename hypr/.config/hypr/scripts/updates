#!/usr/bin/env bash
# Usage: updates list   pending package updates, "name old -> new" per line, AUR ones last
#        updates run    install them (yay -Syu), offer to merge .pacnew files, say when
#                       a reboot is needed, then refresh the bar's update icon
# The bar (Quickshell Updates.qml) checks with `list` every 6 hours and opens `run` in a
# terminal when the icon is clicked.
set -euo pipefail

case ${1:-} in
    list)
        # checkupdates syncs a private copy of the package databases, so the system's
        # own stay as they are (no partial upgrades). Exit 2 means nothing to update.
        checkupdates --nocolor || (( $? == 2 ))
        # yay exits 1 when no AUR package has an update
        { yay -Qua --color never || true; } | sed 's/$/ (AUR)/'
        ;;
    run)
        if yay -Syu; then
            echo "Up to date."
        else
            echo "yay failed; see above."
        fi
        # Configs you changed get the package's new version saved next to them as
        # .pacnew (or yours kept as .pacsave); pacdiff merges them, through sudo.
        pacnew=$(pacdiff --output --nocolor 2>/dev/null || true)
        if [[ -n $pacnew ]]; then
            printf '\nConfig files to merge:\n%s\n' "$pacnew"
            read -rn1 -p "Merge them now with pacdiff? [y/N] " answer
            echo
            if [[ $answer == [yY] ]]; then pacdiff --sudo || true; fi
        fi
        # A kernel upgrade removes the running kernel's modules, so new devices can't
        # load drivers until a reboot
        if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
            printf '\nThe kernel was updated: reboot recommended.\n'
        fi
        quickshell ipc call updates refresh >/dev/null 2>&1 || true
        read -rsn1 -p "Press any key to close."
        ;;
    *)
        echo "Usage: updates list|run" >&2
        exit 1
        ;;
esac
