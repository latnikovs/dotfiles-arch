#!/usr/bin/env bash
# Usage: updates list   pending package updates, "name old -> new" per line, AUR ones last
#        updates run    install them (yay -Syu, one password, one confirmation), offer to merge .pacnew files,
#                       upgrade mise's dev tools and the Neovim plugins (offering to commit lazy-lock.json),
#                       run the health check (scripts/healthcheck) and offer a Claude review of the update
#                       (scripts/update-review), then refresh the bar's update icon; the window stays
#                       open until Q is pressed
# The bar (Quickshell Updates.qml) checks with `list` every 6 hours and opens `run` in a
# terminal when the icon is clicked. What an update changed is saved, as "upgraded name (old -> new)"
# lines from pacman's log, to ~/.local/state/dotfiles/last-update for update-review.
set -euo pipefail

case ${1:-} in
    list)
        # checkupdates syncs a private copy of the package databases, so the system's
        # own stay as they are (no partial upgrades). Exit 2 means nothing to update.
        checkupdates --nocolor || (( $? == 2 ))
        # yay exits 1 when no AUR package has an update
        { yay -Qua --color never || true; } | sed 's/$/ (AUR)/'
        ;;
    run)
        # One run at a time: a second click on the bar icon (or the menu) opened another window that
        # asked for the password again and, once given, repeated the whole update; left unanswered it
        # re-prompts every 5 minutes for good. The lock is held on fd 9 until this run exits, and the
        # file names the holder's terminal, so a second run focuses that window and closes its own.
        lock=${XDG_RUNTIME_DIR:-/tmp}/dotfiles-updates.lock
        exec 9<>"$lock"
        if ! flock -n 9; then
            holder=$(<"$lock")
            if [[ $holder =~ ^[0-9]+$ ]]; then
                # A window left on a special workspace (opened while one was showing) is hidden
                # once that closes, and focusing it doesn't bring it back. hyprland.lua undoes any
                # special workspace shown other than through its showSpecial(), so that shows it
                ws=$(hyprctl clients -j | jq -r --argjson p "$holder" '.[] | select(.pid == $p) | .workspace.name' | head -1)
                if [[ $ws == special:* ]]; then
                    hyprctl eval "showSpecial('${ws#special:}')" >/dev/null 2>&1 || true
                fi
                hyprctl dispatch "hl.dsp.focus({ window = 'pid:$holder' })" >/dev/null 2>&1 || true
            fi
            echo "An update is already running in another window." >&2
            exit 0
        fi
        printf '%s\n' "$PPID" >"$lock"

        state=~/.local/state/dotfiles
        started=$(date '+%F %T')
        logged=$(wc -l </var/log/pacman.log)

        # A header as install.sh's: what this window is, before anything asks for a password
        b=$'\e[1m' d=$'\e[90m' blue=$'\e[34m' cyan=$'\e[36m' r=$'\e[0m'
        if [[ ${TERM:-} == xterm-kitty ]]; then
            title=$'\uf303' lock=$'\uf023' section=$'\uf105' sep=·
        else
            title=◆ lock=› section=▸ sep=·
        fi
        heading() { printf '\n %s %s\n' "$cyan$section$r" "$b$1$r"; }
        # The window closes when the script ends, so it waits for Q: a stray key
        # (Enter after a y/N prompt) doesn't close it before the output is read.
        wait_quit() {
            local key
            printf '\n   %s' "${d}Press Q to close.$r"
            while read -rsn1 key; do [[ $key == [qQ] ]] && break; done
            printf '\n'
            exit 0
        }
        printf '\n %s %s\n' "$blue$title$r" "${b}System update$r $d$sep $(uname -n)$r"
        pending=$("$0" list 2>/dev/null || true)
        count=$(grep -c . <<<"$pending" || true)
        aur=$(grep -c ' (AUR)$' <<<"$pending" || true)
        if (( count == 0 )); then
            printf '   %s\n' "${d}Nothing pending that the bar knows of; yay checks again.$r"
        else
            printf '   %s\n' "$d$count package$( (( count == 1 )) || echo s) to update$( (( aur == 0 )) || echo ", $aur from the AUR")$r"
        fi
        printf '   %s\n\n' "${d}Then mise's dev tools, Neovim plugins, a health check, and Claude's review if you want it.$r"
        # The password, once, for pacman; yay's --sudoloop keeps it fresh from here on
        # sudo gives up after 5 minutes without an answer (passwd_timeout) or 3 wrong passwords;
        # ask again then, so a window left waiting doesn't close by itself (Ctrl+C or closing it quits)
        until sudo -v -p "   $lock sudo password for %u (to install the packages): "; do
            printf '   %s\n' "${d}No password taken; asking again.$r"
        done

        heading "Installing"
        # --answerupgrade None skips yay's "Packages to exclude" menu (the bar already
        # listed them, and excluding some is a partial upgrade). --sudoloop asks for the
        # password once and keeps it fresh, so a slow answer or long AUR build doesn't
        # run past sudo's timeout and ask again.
        yay_ok=true
        if yay -Syu --answerupgrade None --sudoloop; then
            printf '\n   %s\n' "Up to date."
        else
            yay_ok=false
            printf '\n   %s\n' "yay failed; see above."
        fi
        # Configs you changed get the package's new version saved next to them as
        # .pacnew (or yours kept as .pacsave); pacdiff merges them, through sudo.
        pacnew=$(pacdiff --output --nocolor 2>/dev/null || true)
        if [[ -n $pacnew ]]; then
            printf '\nConfig files to merge:\n%s\n' "$pacnew"
            read -rn1 -p "Merge them now with pacdiff? [y/N] " answer
            echo
            if [[ $answer == [yY] ]]; then pacdiff --sudo || true; fi
        fi
        quickshell ipc call updates refresh >/dev/null 2>&1 || true

        # Dev tools: mise upgrades each tool within what config.toml asks for (node = "lts"
        # stays on LTS). Changes are logged as "upgraded mise:<tool> (old -> new)".
        mise_changed=
        # mise's installer (Arch Linux ARM) puts it in ~/.local/bin, which only .zshrc adds to
        # PATH, so a window the bar opens doesn't find it there
        if ! command -v mise >/dev/null && [[ -x ~/.local/bin/mise ]]; then PATH=$HOME/.local/bin:$PATH; fi
        if ! command -v mise >/dev/null; then
            heading "Dev tools (mise)"
            printf '   %s\n' "mise not found; skipped."
        else
            heading "Dev tools (mise)"
            # "tool<TAB>version" lines: every installed version (before), the active ones (after).
            # Not the active ones before: `mise ls --current` shows the version a request resolves
            # to even when it isn't installed (node = "lts" once a new LTS line is out), so the
            # change would be missed.
            mise_versions() {
                mise ls "$1" --json 2>/dev/null \
                    | jq -r --arg flag "$1" 'to_entries[] | .key as $t | .value[]
                        | select($flag == "--installed" or (.active and .installed)) | "\($t)\t\(.version)"' \
                    | sort -t $'\t' -k1,1 -k2,2V || true
            }
            # Arch Linux ARM has no mise package (install.sh uses mise's installer there),
            # so mise updates itself; elsewhere pacman updated it above
            if ! pacman -Qqo "$(command -v mise)" >/dev/null 2>&1; then
                old=$(mise --version 2>/dev/null | cut -d' ' -f1 || true)
                mise self-update --yes || printf '   %s\n' "mise self-update failed; see above."
                new=$(mise --version 2>/dev/null | cut -d' ' -f1 || true)
                [[ $old == "$new" ]] || mise_changed="upgraded mise ($old -> $new)"
            fi
            before=$(mise_versions --installed)
            mise upgrade --yes || printf '   %s\n' "mise upgrade failed; see above."
            after=$(mise_versions --current)
            # An active version that wasn't installed before is new: upgraded from the tool's
            # newest version before it, or installed if there was none
            tools=$(awk -F'\t' 'NR == FNR { had[$0]; last[$1] = $2; next }
                !($0 in had) { print ($1 in last ? "upgraded mise:" $1 " (" last[$1] " -> " $2 ")" \
                                                 : "installed mise:" $1 " (" $2 ")") }' \
                <(printf '%s\n' "$before") <(printf '%s\n' "$after"))
            mise_changed=$(printf '%s\n' "$mise_changed" "$tools" | grep . || true)
            printf '   %s\n' "${mise_changed:-Up to date.}"
        fi

        # Neovim plugins: lazy.nvim updates them and rewrites lazy-lock.json, which lives in
        # the dotfiles, so the other machines get the same versions (Lazy restore) once it's
        # committed. Changes are logged as "upgraded nvim:<plugin> (old -> new commit)".
        nvim_changed=
        lockfile=$(readlink -f ~/.config/nvim/lazy-lock.json 2>/dev/null || true)
        if command -v nvim >/dev/null && [[ -f $lockfile ]]; then
            heading "Neovim plugins"
            old_lock=$(<"$lockfile")
            # Headless lazy logs every task of every plugin, so to a file, shown only on failure
            nvim_log=$state/nvim-update.log
            mkdir -p "$state"
            if nvim --headless '+Lazy! update' +qa >"$nvim_log" 2>&1; then
                nvim_changed=$(jq -r --argjson old "$old_lock" 'to_entries[]
                    | select($old[.key] and $old[.key].commit != .value.commit)
                    | "upgraded nvim:\(.key) (\($old[.key].commit[:7]) -> \(.value.commit[:7]))"' \
                    "$lockfile" || true)
                printf '   %s\n' "${nvim_changed:-Up to date.}"
            else
                tail -n 20 "$nvim_log" | sed 's/^/   /'
                printf '   %s\n' "Lazy update failed; full log: ${nvim_log/#$HOME/\~}"
            fi
            repo=$(git -C "${lockfile%/*}" rev-parse --show-toplevel 2>/dev/null || true)
            if [[ -n $nvim_changed && -n $repo ]]; then
                read -rn1 -p "   Commit the new lockfile to ${repo/#$HOME/\~}? [y/N] " answer
                echo
                if [[ $answer == [yY] ]]; then
                    # Only the lockfile, whatever else is staged
                    git -C "$repo" commit -q -m "chore(nvim): update plugin lockfile" -- "$lockfile" \
                        && printf '   %s\n' "Committed (not pushed)." || true
                fi
            fi
        fi

        # What changed: this run's lines of pacman's log, without the timestamps, then mise's and lazy's
        changed=$(tail -n +"$((logged + 1))" /var/log/pacman.log \
            | sed -nE 's/^\[[^]]*\] \[ALPM\] ((upgraded|downgraded|installed|removed) .*)$/\1/p')
        all_changed=$(printf '%s\n' "$changed" "$mise_changed" "$nvim_changed" | grep . || true)
        if [[ -z $all_changed ]]; then
            wait_quit
        fi
        mkdir -p "$state"
        printf '# Updated %s on %s\n%s\n' "$started" "$(uname -n)" "$all_changed" >"$state/last-update"

        # Does everything still work? (also at the next login, where more of the update takes effect)
        heading "Health check"
        printf '\n'
        "${BASH_SOURCE[0]%/*}/healthcheck" --since "$started" | sed 's/^/   /' || true
        heading "Review"
        printf '   %s\n' "${d}Claude reads the release notes of what changed, checks them against the dotfiles,$r" \
            "${d}and looks into the problems above. It opens in a window of its own.$r"
        read -rn1 -p "   Review now? [y/N] " answer
        echo
        if [[ $answer == [yY] ]]; then
            setsid -f "${BASH_SOURCE[0]%/*}/update-review" >/dev/null 2>&1 9>&-
        fi

        # What it came to, last, right above the Q prompt: the counts per kind of change
        # (AUR ones are the foreign packages), the health check's tally, and what to restart
        heading "Summary"
        foreign=$(pacman -Qmq)
        counts=
        for kind in upgraded installed downgraded removed; do
            names=$(sed -n "s/^$kind \([^ ]*\) .*/\1/p" <<<"$changed")
            [[ -n $names ]] || continue
            n=$(grep -c . <<<"$names")
            from_aur=$(grep -cxFf <(printf '%s\n' "$foreign") <<<"$names" || true)
            counts+="${counts:+ $sep }$n $kind$( (( from_aur == 0 )) || echo " ($from_aur AUR)")"
        done
        n=$(grep -c . <<<"$mise_changed" || true)
        (( n == 0 )) || counts+="${counts:+ $sep }$n mise tool$( (( n == 1 )) || echo s)"
        n=$(grep -c . <<<"$nvim_changed" || true)
        (( n == 0 )) || counts+="${counts:+ $sep }$n Neovim plugin$( (( n == 1 )) || echo s)"
        printf '   %s\n' "$counts"
        $yay_ok || printf '   %s\n' "yay failed: not everything was updated (see above)"
        report=$state/healthcheck.log
        printf '   Health check: %s\n' "$(tail -n1 "$report")"
        if grep -q '^· The kernel was updated' "$report"; then
            printf '   %s\n' "${b}Reboot needed:$r the kernel was updated"
        elif grep -q '^· Running the version from before the update' "$report"; then
            printf '   %s\n' "${b}Log out and back in:$r running programs are the old versions"
        fi
        wait_quit
        ;;
    *)
        echo "Usage: updates list|run" >&2
        exit 1
        ;;
esac
