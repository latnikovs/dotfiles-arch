#!/usr/bin/env bash
# Usage: agents   tmux in a terminal, on the workspace last used (SUPER + G)
set -euo pipefail

# Started in ~/Work like the agent script, so Claude inside it has a trusted directory
mkdir -p "$HOME/Work"
cd "$HOME/Work"

# DOTFILES_TERMINAL is set per machine (e.g. kitty with software GL in the UTM VM), unquoted
# so it can carry "env VAR=… kitty". A fixed class lets window rules single the window out.
# With no server, a plain new-session is what tmux-continuum restores the saved workspaces
# over: it replaces that first unnamed session with them (see tmux.conf).
exec ${DOTFILES_TERMINAL:-kitty} --class org.dotfiles.agents \
    sh -c 'tmux attach 2>/dev/null || exec tmux new-session'
