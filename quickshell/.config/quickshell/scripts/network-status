#!/usr/bin/env bash
# Usage: network-status   print the default route's connection as JSON for the bar
#   {"type":"ethernet|wifi|disconnected","dev":"...","ip":"...","signal":0-100,"ssid":"..."}
set -euo pipefail

dev=$(ip route show default | awk '{ print $5; exit }')
if [[ -z $dev ]]; then
    jq -nc '{type: "disconnected"}'
    exit
fi
ip=$(ip -4 -o addr show dev "$dev" | awk '{ sub(/\/.*/, "", $4); print $4; exit }')

if [[ -d /sys/class/net/$dev/wireless ]]; then
    # Link quality is out of 70 in /proc/net/wireless
    signal=$(awk -v d="$dev:" '$1 == d { print int($3 * 100 / 70) }' /proc/net/wireless)
    ssid=$(command -v iw >/dev/null && iw dev "$dev" link | sed -n 's/^\s*SSID: //p' || true)
    jq -nc --arg dev "$dev" --arg ip "$ip" --argjson signal "${signal:-0}" --arg ssid "$ssid" \
        '{type: "wifi", $dev, $ip, $signal, $ssid}'
else
    jq -nc --arg dev "$dev" --arg ip "$ip" '{type: "ethernet", $dev, $ip}'
fi
